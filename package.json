{
  "name": "forum-api-submission",
  "version": "1.0.0",
  "description": "Dicoding Forum API submission using Express, PostgreSQL, Clean Architecture, and automated testing",
  "main": "src/app.js",
  "scripts": {
    "start": "npm run migrate:reset && node src/app.js",
    "start:dev": "npm run migrate:reset && nodemon src/app.js",
    "migrate:reset": "node-pg-migrate down all && node-pg-migrate up",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "migrate": "node-pg-migrate up",
    "migrate:test": "cross-env NODE_ENV=test node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "lint": "eslint .",
    "test:clean": "npm run migrate down && npm run migrate up && npm test",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^3.3.7",
    "pg": "^8.13.1"
  },
"devDependencies": {
    "@eslint/js": "^9.21.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.8.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}
